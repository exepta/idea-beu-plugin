<idea-plugin>
    <id>com.tiltus.beu.parser</id>
    <name>Bevy HTML Support</name>
    <vendor email="genshin.exepta@outlook.com" url="http://tilt-us.com/libraries/docs/bevy_extended_ui/">Tiltus</vendor>

    <description><![CDATA[
        <p>RustRover plugin for Bevy and bevy_extended_ui workflows.</p>
        <ul>
            <li>Bevy New Project Wizard with version, feature, and asset selection.</li>
            <li>Beu Generate action in the project tree context menu.</li>
            <li>HTML support for bevy_extended_ui templates (completion, docs, inspections, formatting).</li>
        </ul>
    ]]></description>
    <change-notes><![CDATA[
        First version.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.xml</depends>

    <extensions defaultExtensionNs="com.intellij">
        <annotator language="HTML" implementationClass="com.tiltus.beu.plugin.html.BeuHtmlAnnotator"/>
        <completion.contributor language="HTML" implementationClass="com.tiltus.beu.plugin.html.BeuHtmlCompletionContributor" order="first"/>
        <lang.documentationProvider language="HTML" implementationClass="com.tiltus.beu.plugin.html.BeuHtmlDocumentationProvider"/>
        <postFormatProcessor implementationClass="com.tiltus.beu.plugin.format.BeuDirectivePostFormatProcessor" order="last"/>
        <typedHandler implementationClass="com.tiltus.beu.plugin.format.BeuDirectiveTypedHandler"/>
        <enterHandlerDelegate implementationClass="com.tiltus.beu.plugin.format.BeuDirectiveEnterHandler"/>
        <copyPastePreProcessor implementationClass="com.tiltus.beu.plugin.format.BeuDirectiveCopyPastePreProcessor"/>
        <psi.referenceContributor language="HTML" implementation="com.tiltus.beu.plugin.references.BeuHtmlFnReferenceContributor"/>
        <psi.referenceContributor language="XML" implementation="com.tiltus.beu.plugin.references.BeuHtmlFnReferenceContributor"/>
        <psi.referenceContributor language="HTML" implementation="com.tiltus.beu.plugin.references.BeuHtmlStructReferenceContributor"/>
        <psi.referenceContributor language="XML" implementation="com.tiltus.beu.plugin.references.BeuHtmlStructReferenceContributor"/>
        <localInspection language="HTML"
                         shortName="BeuMissingEventHandler"
                         displayName="Missing BeU event handler"
                         groupName="BeU HTML"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.tiltus.beu.plugin.html.BeuHtmlMissingEventHandlerInspection"/>
        <lang.inspectionSuppressor language="HTML" implementationClass="com.tiltus.beu.plugin.html.BeuHtmlInspectionSuppressor"/>
        <lang.inspectionSuppressor language="CSS" implementationClass="com.tiltus.beu.plugin.html.BeuHtmlInspectionSuppressor"/>
        <highlightErrorFilter implementation="com.tiltus.beu.plugin.html.BeuHtmlHighlightErrorFilter"/>
        <directoryProjectGenerator implementation="com.tiltus.beu.plugin.project.BevyDirectoryProjectGenerator"/>
        <newProjectWizard.languageGenerator implementation="com.tiltus.beu.plugin.project.BevyNewProjectWizard"/>
    </extensions>

    <actions>
        <action
                id="com.tiltus.beu.plugin.actions.NewBeuComponentAction"
                class="com.tiltus.beu.plugin.actions.NewBeuComponentAction"
                text="Beu Generate"
                icon="/icons/beuComponentPlus.svg"
                description="Generate beu files">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
